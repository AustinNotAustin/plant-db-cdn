# AWS Account ID (for ExpectedBucketOwner verification)
AWS_ACCOUNT_ID="123456789012"

# AWS S3 Access Key
AWS_S3_ACCESS_KEY_ID=

# AWS S3 Secret Access Key
AWS_S3_SECRET_ACCESS_KEY=

# Listening port for the container
SRV_CDN_PORT=8001

# Internal/External link for the CDN service
SRV_CDN_URL=

# Local root containing simulated buckets
S3_STORAGE_ROOT=s3_buckets

# Bucket served by /cdn/{key}
S3_DEFAULT_CDN_BUCKET=s3_longterm

# true keeps legacy company_X/plant_Y PUT policy
S3_ENFORCE_PLANT_HIERARCHY=false
