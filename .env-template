# AWS Account ID (for ExpectedBucketOwner verification)
AWS_ACCOUNT_ID="123456789012"

# AWS S3 Access Key
AWS_S3_ACCESS_KEY_ID=mock-access-key

# AWS S3 Secret Access Key
AWS_S3_SECRET_ACCESS_KEY=mock-secret-key

# Listening port for the container
SRV_MOCK_S3_PORT=8001

# Browser-reachable URL for this Mock S3 service
SRV_MOCK_S3_URL=http://localhost:8001

# Local root containing simulated buckets
S3_STORAGE_ROOT=s3_buckets

# Bucket served by /cdn/{key}
S3_DEFAULT_PUBLIC_BUCKET=s3_dev_media
